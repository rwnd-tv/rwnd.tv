# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- Postgres (used by both the `db` and `app` services below) ---
POSTGRES_USER=rwnd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rwnd

# --- rwnd.tv ---
# Built from the two POSTGRES_* values above; only change this if you're
# pointing at a database you manage yourself instead of the bundled `db`
# service.
DATABASE_URL=postgres://rwnd:change-me@db:5432/rwnd

# Get a free key at https://www.themoviedb.org/settings/api — required,
# rwnd.tv has no metadata of its own to search against without it.
TMDB_API_KEY=

# Must be true once you're serving over HTTPS (e.g. behind a reverse proxy
# like nginx-pm) — browsers refuse Secure cookies over plain HTTP.
COOKIE_SECURE=false

# Optional. Shown as a badge in the header and in the browser tab title —
# useful if you run more than one instance (e.g. a production one and a
# personal/dev one) and want to tell them apart at a glance. Leave unset
# for a normal single-instance deployment.
ENVIRONMENT_LABEL=
