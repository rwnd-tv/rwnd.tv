# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- Postgres (used by both the `db` and `app` services below) ---
POSTGRES_USER=rwnd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rwnd

# Optional. Which host interface docker-compose.yml binds the app's port
# 3000 to — defaults to all interfaces (0.0.0.0), same as before this was
# configurable. Set to 127.0.0.1 to make the container reachable only
# from this host itself (e.g. when a reverse proxy on the same machine is
# the only thing that should ever reach it directly).
BIND_ADDRESS=

# --- rwnd.tv ---
# Built from the two POSTGRES_* values above; only change this if you're
# pointing at a database you manage yourself instead of the bundled `db`
# service.
DATABASE_URL=postgres://rwnd:change-me@db:5432/rwnd

# Set to true only if the database above is remote/managed and requires or
# offers TLS. Leave unset for the bundled `db` service above — it sits on
# the same docker-compose network as this container, an unencrypted link
# both containers already implicitly trust.
DATABASE_SSL=

# At least one of TMDB_API_KEY / TVDB_API_KEY is required — rwnd.tv has no
# metadata of its own to search against without a provider. Both can be set
# at once; which one is used for a given title is admin-configurable under
# Settings once more than one is.
#
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TheTVDB v4 API (https://www.thetvdb.com/api-information) needs an account
# — either a paid/commercial key, or a free "user-supported" key paired
# with your subscriber PIN. Leave TVDB_PIN unset for a commercial key.
TVDB_API_KEY=
TVDB_PIN=

# Set to true once you're serving over HTTPS (e.g. behind a reverse proxy
# like nginx-pm) — browsers refuse Secure cookies over plain HTTP.
# Deliberately left unset here rather than defaulting to false: with
# nothing set, rwnd.tv defaults this to true in production on its own
# (apps/api/src/env.ts) — the common case, since anything reachable
# beyond your own machine should be behind TLS. Only set this to false if
# you're deliberately running without HTTPS (e.g. LAN-only access with no
# reverse proxy in front).
COOKIE_SECURE=

# Set to true only if a reverse proxy you trust sits in front of this
# container and sets X-Forwarded-For itself — it's used to key rate
# limiting (login, registration, ...) per client IP. Leave unset/false if
# you're not behind a proxy (e.g. exposing the container's port
# directly): trusting that header unconditionally would let any client
# spoof its own rate-limit bucket.
TRUST_PROXY=

# Optional. Set all three to enable importing history/ratings/watchlist
# from Trakt (Settings > Import). Register a free app at
# https://trakt.tv/oauth/applications — redirect URI doesn't matter, the
# device flow rwnd.tv uses doesn't redirect anywhere. Leave unset and the
# Import page hides itself.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Required whenever TRAKT_CLIENT_ID is set — encrypts the Trakt tokens
# rwnd.tv stores for you. Generate with `openssl rand -base64 32`. Losing
# this means reconnecting Trakt, not losing any imported data.
ENCRYPTION_KEY=

# Optional. Shown as a badge in the header and in the browser tab title —
# useful if you run more than one instance (e.g. a production one and a
# personal/dev one) and want to tell them apart at a glance. Leave unset
# for a normal single-instance deployment.
ENVIRONMENT_LABEL=

# Optional. Enables Settings > Database's per-user backup/restore. This is
# a path *inside the container* — it only needs setting (and only takes
# effect) if you've also uncommented the matching `volumes:` line under
# the `app` service in docker-compose.yml, mounting a real directory on
# this host to it. Leave unset and that section of the Database panel
# just doesn't appear. See docs/self-hosting.md's Backups section.
BACKUP_DIR=

# Optional. Set all five to enable outbound email — account verification
# and "Forgot password?" (Profile page / login page). Leave unset and
# those hide themselves rather than erroring. Plain SMTP, not a specific
# provider's API — any mail relay works: Gmail with an App Password
# (smtp.gmail.com, port 587), a transactional-email provider's own SMTP
# endpoint, a mail server you run yourself, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender on verification/reset emails, e.g.
# "rwnd.tv <noreply@example.com>".
SMTP_FROM=
# This instance's own public URL (no trailing slash) — required alongside
# SMTP_HOST, since it's what verification/reset links in the email
# actually point at, e.g. https://rwnd.tv.
APP_URL=
