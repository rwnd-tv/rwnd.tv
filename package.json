{
  "name": "rwnd.tv",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "rwnd.tv (rewind dot tv) — self-hosted tracking for what you watch.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:api": "pnpm --filter @rwnd/api dev",
    "dev:web": "pnpm --filter @rwnd/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "knip": "cross-env DATABASE_URL=postgres://knip:knip@localhost:5432/knip knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @rwnd/db generate",
    "db:migrate": "pnpm --filter @rwnd/db migrate",
    "db:seed": "pnpm --filter @rwnd/db seed",
    "db:reset-dev": "pnpm --filter @rwnd/db reset-dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "knip": "^6.33.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
