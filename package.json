{
  "name": "rwnd.tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "rwnd.tv (rewind dot tv) — self-hosted tracking for what you watch.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:api": "pnpm --filter @rwnd/api dev",
    "dev:web": "pnpm --filter @rwnd/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @rwnd/db generate",
    "db:migrate": "pnpm --filter @rwnd/db migrate",
    "db:seed": "pnpm --filter @rwnd/db seed",
    "db:reset-dev": "pnpm --filter @rwnd/db reset-dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
